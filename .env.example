# Cloudflare Workers AI credentials (wajib)
# Account ID: Cloudflare Dashboard -> Workers & Pages / AI -> Account ID (sidebar kanan)
# API Token : My Profile -> API Tokens -> Create Token -> template "Workers AI"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opsional: paksa model tertentu (satu atau beberapa, dipisah koma, dicoba berurutan).
# Kosongkan untuk memakai daftar default dengan fallback otomatis.
# Model yang namanya mengandung "inpaint" akan dikirimi image + mask (mode inpainting).
# CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell

# Opsional: lewat Cloudflare AI Gateway
# CLOUDFLARE_API_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/workers-ai
